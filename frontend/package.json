{
  "name": "lake-frontend",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens": "node ../tools/ui/build-tokens.mjs",
    "build": "tsc -b && npm test && vite build && node --import ./scripts/watch-copied-reads.mjs scripts/check-effects.mjs && node --import ./scripts/watch-copied-reads.mjs scripts/check-list-errors.mjs",
    "test": "TZ=America/Vancouver node --experimental-strip-types --no-warnings --import ./scripts/watch-copied-reads.mjs --test tests/*.test.ts",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
